{
    "name": "hakuneko-next",
    "version": "1.4.1",
    "title": "HakuNeko-Next",
    "productName": "HakuNeko-Next",
    "description": "Téléchargeur et gestionnaire de bibliothèque pour mangas, animés et romans",
    "license": "Unlicense",
    "homepage": "https://github.com/Endymi0n74/Hakuneko-next",
    "type": "module",
    "workspaces": [
        "web",
        "app/nw",
        "app/electron",
        "docs"
    ],
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/chrome": "0.2.0",
        "@types/nw.js": "0.92.0",
        "cross-env": "^10.0.0",
        "eslint": "10.6.0",
        "eslint-plugin-tsdoc": "0.5.2",
        "puppeteer-core": "25.2.1",
        "tslib": "2.8.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.62.1",
        "vite": "8.1.2",
        "vitest": "4.1.9"
    },
    "scripts": {
        "check": "npm run check --workspaces",
        "test": "npm run test --workspaces",
        "test:e2e": "npm run build --workspaces && vitest run --config=test/vitest.e2e.js",
        "test:websites": "npm run build --workspaces && vitest run --config=test/vitest.websites.js",
        "npm:clean-install": "npm install --package-lock-only --allow-git=all && npm install --allow-git=all",
        "postinstall": "npm --workspace=app/electron exec electron -- --no-sandbox --version",
        "version:bump": "node scripts/version-bump.mjs"
    }
}
